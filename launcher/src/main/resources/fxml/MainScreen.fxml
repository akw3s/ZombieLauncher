<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="main-screen" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.blen.launcher.controller.MainScreenController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar">
            <padding>
                <Insets bottom="16.0" left="34.0" right="34.0" top="16.0"/>
            </padding>
            <ImageView fitHeight="38.0" fitWidth="38.0" preserveRatio="true">
                <image>
                    <Image url="@../icons/icon.png"/>
                </image>
            </ImageView>
            <Label text="ZOMBIELAUNCHER" styleClass="app-title-small"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="settingsButton" onAction="#handleSettings" text="Settings"
                    styleClass="header-button"/>
        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER" fillHeight="true" spacing="22.0">
            <padding>
                <Insets bottom="26.0" left="38.0" right="38.0" top="30.0"/>
            </padding>

            <VBox alignment="CENTER_LEFT" maxHeight="Infinity" maxWidth="Infinity"
                  spacing="18.0" styleClass="profile-card" HBox.hgrow="ALWAYS">
                <Label fx:id="profileHeading" text="YOUR PROFILE" styleClass="eyebrow"/>
                <Label fx:id="welcomeLabel" styleClass="welcome-text"/>
                <Region prefHeight="1.0" styleClass="divider"/>
                <Label fx:id="gameHeading" text="MINECRAFT" styleClass="eyebrow"/>
                <Label text="1.20.1" styleClass="version-number"/>
                <Label text="FORGE 47.4.29" styleClass="version-tag"/>
                <Label fx:id="profileDescription" text="The classic modded survival experience."
                       styleClass="card-caption"
                       wrapText="true"/>
            </VBox>

            <VBox alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity"
                  spacing="17.0" styleClass="play-card" HBox.hgrow="ALWAYS">
                <StackPane styleClass="mod-badge">
                    <Label text="AM" styleClass="mod-badge-text"/>
                </StackPane>
                <Label fx:id="modName" text="AutoModpack 4.0.7" styleClass="mod-title"/>
                <Label fx:id="modCompatibility" text="Compatible • Forge 1.20.1"
                       styleClass="mod-subtitle"/>
                <Button fx:id="launchButton" onAction="#handleLaunch" text="LAUNCH GAME"
                        styleClass="launch-button" maxWidth="300.0"/>
                <ProgressIndicator fx:id="progressIndicator" maxHeight="28.0" maxWidth="28.0"
                                   visible="false" managed="false"/>
                <Label fx:id="statusLabel" text="Configured for Forge 1.20.1."
                       styleClass="status-text" wrapText="true"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>
